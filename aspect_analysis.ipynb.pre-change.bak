    "import pandas as pd\n",
    "\n",
    "aspect_checks = pd.DataFrame([\n",
    "    {\n",
    "        \"text\": \"The battery drains quickly.\",\n",
    "        \"aspect\": \"battery\",\n",
    "        \"expected\": \"negative\"\n",
    "    },\n",
    "    {\n",
    "        \"text\": \"The sound is excellent.\",\n",
    "        \"aspect\": \"sound\",\n",
    "        \"expected\": \"positive\"\n",
