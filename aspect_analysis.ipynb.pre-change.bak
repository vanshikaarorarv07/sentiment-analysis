   "source": [
    "import re\n",
    "import joblib\n",
    "\n",
    "sentiment_model = joblib.load(\"sentiment_pipeline.pkl\")\n",
    "\n",
    "def clean_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \" \", text)\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "    return text\n",
    "\n",
    "print(\"Model and cleaning function are ready\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b20462b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_review(text):\n",
    "    results = []\n",
    "\n",
    "    for part in split_review(text):\n",
    "        aspects = detect_aspects(part)\n",
    "\n",
    "        if not aspects:\n",
    "            continue\n",
    "\n",
    "        if len(aspects) > 1:\n",
    "            sentiment = \"needs_review\"\n",
    "        else:\n",
    "            sentiment = sentiment_model.predict(\n",
    "                [clean_text(part)]\n",
    "            )[0]\n",
    "\n",
    "        results.append({\n",
    "            \"text\": part,\n",
    "            \"aspects\": aspects,\n",
    "            \"sentiment\": sentiment\n",
    "        })\n",
    "\n",
    "    return results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "ade14339",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_pros_cons(text):\n",
    "    output = {\n",
    "        \"pros\": [],\n",
    "        \"cons\": [],\n",
    "        \"neutral\": [],\n",
    "        \"needs_review\": []\n",
    "    }\n",
    "\n",
    "    for result in analyze_review(text):\n",
    "        sentiment = result[\"sentiment\"]\n",
    "\n",
    "        if sentiment == \"positive\":\n",
    "            output[\"pros\"].append(result)\n",
    "\n",
    "        elif sentiment == \"negative\":\n",
    "            output[\"cons\"].append(result)\n",
    "\n",
    "        elif sentiment == \"neutral\":\n",
    "            output[\"neutral\"].append(result)\n",
    "\n",
    "        else:\n",
    "            output[\"needs_review\"].append(result)\n",
    "\n",
    "    return output"
   ]
  },
