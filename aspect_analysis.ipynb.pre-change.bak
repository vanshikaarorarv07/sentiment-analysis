   "id": "e35ebe3f",
   "metadata": {},
   "outputs": [],
   "source": [
    "aspect_keywords = {\n",
    "    \"battery\": [\"battery\", \"battery life\", \"battery backup\"],\n",
    "    \"sound\": [\"sound\", \"audio\", \"bass\", \"volume\"],\n",
    "    \"camera\": [\"camera\", \"photo\", \"picture\", \"video quality\"],\n",
    "    \"display\": [\"screen\", \"display\", \"brightness\"],\n",
    "    \"performance\": [\"performance\", \"speed\", \"lag\", \"slow\", \"crashing\"],\n",
    "    \"comfort\": [\"comfortable\", \"uncomfortable\", \"comfort\", \"ear pain\"],\n",
    "    \"build_quality\": [\"build quality\", \"durable\", \"flimsy\", \"sturdy\"],\n",
    "    \"price\": [\"price\", \"expensive\", \"cheap\", \"value for money\"],\n",
    "    \"connectivity\": [\"bluetooth\", \"wifi\", \"wi-fi\", \"connection\"],\n",
    "    \"charging\": [\"charging\", \"charger\", \"charges\"]\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "87e945d7",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "def detect_aspects(text):\n",
    "    text = text.lower()\n",
    "    detected = []\n",
    "\n",
    "    for aspect, keywords in aspect_keywords.items():\n",
    "        for keyword in keywords:\n",
    "            pattern = r\"\\b\" + re.escape(keyword) + r\"\\b\"\n",
    "\n",
    "            if re.search(pattern, text):\n",
    "                detected.append(aspect)\n",
    "                break\n",
    "\n",
    "    return detected"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "93c52513",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['sound', 'comfort']\n"
     ]
    }
   ],
   "source": [
    "review = \"The sound is good, but the headphones are uncomfortable.\"\n",
    "\n",
    "print(detect_aspects(review))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f185e9a7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def split_review(text):\n",
    "    parts = re.split(\n",
    "        r\"[.!?;]+|\\b(?:but|however|although|yet)\\b\",\n",
    "        text,\n",
    "        flags=re.IGNORECASE\n",
    "    )\n",
    "\n",
    "    return [part.strip() for part in parts if part.strip()]"
   ]
  },
